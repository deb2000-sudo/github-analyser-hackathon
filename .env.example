# Server — Cloud Run sets PORT
PORT=8000
HOST=0.0.0.0

# ==================== Firebase (auth + Firestore) ====================
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_WEB_API_KEY=

# Isolated Firestore collection for this analyser (auto-created on first write)
FIRESTORE_COLLECTION_JOBS=githubanalysis_jobs

# ==================== Vertex AI (Gemini) + GCS ====================
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
EVALUATION_BUCKET_NAME=your-project-hackathon-evaluations
GEMINI_MODEL=gemini-2.5-flash
GCS_CACHE_PREFIX=github-cache
GITHUB_CACHE_TTL_SECONDS=86400

# GitHub (recommended)
GITHUB_TOKEN=

# Optional hackathon window (ISO 8601)
HACKATHON_START=
HACKATHON_END=

# Rubric weights (JSON array) — override per request via context.scoring or options.scoring
# RUBRIC_WEIGHTS_JSON=[{"id":"fullstack","label":"Full-stack demo","weight":20,"max_score":10,"metric":"fullstack"},{"id":"ai_usage","label":"Uses an LLM","weight":25,"max_score":10,"metric":"ai_usage"},{"id":"agent_analysis","label":"Agent orchestration","weight":25,"max_score":10,"metric":"agent_analysis"},{"id":"solution_fit","label":"Solution fit","weight":30,"max_score":10,"metric":"solution_fit"}]
