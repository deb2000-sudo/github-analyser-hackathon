# Server — Cloud Run sets PORT
PORT=8000
HOST=0.0.0.0

# GCP
GCP_PROJECT_ID=your-gcp-project
GCP_LOCATION=us-central1

# Firebase / Firestore (ADC on Cloud Run; optional SA JSON for local)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIRESTORE_COLLECTION_JOBS=analysis_jobs

# GCS cache for GitHub snapshots (create bucket first)
GCS_BUCKET=your-project-github-analyser-cache
GCS_CACHE_PREFIX=github-cache
GITHUB_CACHE_TTL_SECONDS=86400

# Vertex AI Gemini
VERTEX_MODEL=gemini-2.0-flash
VERTEX_ENABLED=true

# GitHub (recommended)
GITHUB_TOKEN=

# Optional hackathon window (ISO 8601)
HACKATHON_START=
HACKATHON_END=
